{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  
    "Mqtt": {
      "Host": "localhost",
      "Port": 1883,
      "ClientId": "iot-simulator",
      "Topic": "factory/{site}/{line}/{machine}/telemetry"
    },
    "Simulator": {
      "MachineCount": 1,
      "PublishIntervalMs": 1000,
      "FaultProbability": 0.01
    }
  
}
